# Copy to apps/web/.env.local  (never commit the real key)
# Get a key at https://console.groq.com/keys

GROQ_API_KEY=

# Optional. Default is openai/gpt-oss-20b (on Groq free/dev keys).
# Higher quality if your plan allows it: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b

# Already the default — only set if you proxy Groq
# GROQ_BASE_URL=https://api.groq.com/openai/v1
